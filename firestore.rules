rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Functii ajutatoare de securitate
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Reguli pentru colectia 'groups'
    match /groups/{groupId} {
      // Oricine autentificat poate citi grupurile (sau cauta dupa viewCode / editCode)
      allow read: if isAuthenticated();
      
      // Creare grup: utilizatorul trebuie sa fie autentificat si sa se declare proprietar
      allow create: if isAuthenticated() 
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60;
        
      // Doar proprietarul poate actualiza sau sterge grupul
      allow update: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
    }

    // Reguli pentru colectia 'groupMembers'
    match /groupMembers/{memberDocId} {
      // Citire: utilizatorii autentificati
      allow read: if isAuthenticated();
      
      // Alaturare la grup: utilizatorul adauga propriul sau uid
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      
      // Iesire din grup sau eliminare membru de catre proprietar
      allow delete: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.ownerUid == request.auth.uid
      );
      
      allow update: if isAuthenticated() && (
        get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.ownerUid == request.auth.uid
      );
    }

    // Reguli pentru colectia 'pins' (locatii pe harta)
    match /pins/{pinId} {
      // Citire pinuri: utilizatori autentificati
      allow read: if isAuthenticated();
      
      // Creare pin: utilizatorul autentificat seteaza proprietarul ca fiind el insusi
      allow create: if isAuthenticated() 
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.lat is number
        && request.resource.data.lng is number;
        
      // Modificare pin: doar proprietarul pinului
      allow update: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
      
      // Stergere pin: doar proprietarul pinului
      allow delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
    }

    // Blocare implicita pentru orice alta colectie nespecificata
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
